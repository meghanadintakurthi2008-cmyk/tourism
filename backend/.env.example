# TravelAI Production-Ready Backend Environment Configuration

# Database: SQLite for development, or PostgreSQL for production (e.g. postgresql://user:pass@localhost:5432/travelai)
DATABASE_URL=sqlite:///./travelai.db

# JWT Security
SECRET_KEY=travelai-super-secure-production-secret-key-2026-sih
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# External API Keys (Optional - fallbacks to realistic mock AI/Weather if empty)
AI_API_KEY=
AI_PROVIDER=gemini # gemini or openai
WEATHER_API_KEY=
MAPS_API_KEY=
HOTEL_API_KEY=

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Application Environment
ENVIRONMENT=development
PROJECT_NAME=TravelAI Backend
API_V1_STR=/api
