# TravelAI Environment Variables
# Copy to .env to configure external live APIs if desired

# Gemini / OpenAI API Key for real-time live LLM responses
VITE_AI_API_KEY=
VITE_AI_PROVIDER=gemini # or openai

# Google Maps or Mapbox API Key
VITE_MAP_API_KEY=

# OpenWeatherMap API Key
VITE_WEATHER_API_KEY=

# Hotel & Flights Aggregator API
VITE_HOTEL_API_KEY=
